; Punteros y arrays.
;
; Los tipos se escriben como listas: (int *) es int *, (char * *) es char **,
; (int 5) es int [5]. (& x) es &x, (* p) es *p y (aref a i) es a[i].
;
;   ./alma -o punteros examples/05_punteros_y_arrays.alma && ./punteros

(function intercambiar void ((a (int *)) (b (int *)))
  (variable t int (* a))
  (= (* a) (* b))
  (= (* b) t))

(function sumar int ((v (int *)) (n int))
  (variable total int 0)
  (for ((variable i int 0) (< i n) (++ i))
    (+= total (aref v i)))
  (return total))

(function main int ((argc int) (argv (char * *)))
  (variable x int 1)
  (variable y int 2)
  (intercambiar (& x) (& y))
  (printf "x = %d, y = %d\n" x y)

  ; Array local
  (variable numeros (int 5))
  (for ((variable i int 0) (< i 5) (++ i))
    (= (aref numeros i) (* i i)))
  (printf "suma de cuadrados: %d\n" (sumar numeros 5))

  ; Aritmetica de punteros
  (variable p (int *) numeros)
  (+= p 2)
  (printf "numeros[2] = %d, numeros[3] = %d\n" (* p) (* (+ p 1)))
  (printf "distancia: %ld\n" (cast long (- p numeros)))

  ; Argumentos del programa
  (printf "programa: %s, argumentos: %d\n" (aref argv 0) (- argc 1))
  (return 0))
